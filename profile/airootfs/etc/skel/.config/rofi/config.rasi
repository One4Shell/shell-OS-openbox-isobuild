configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Colorful-Dark-Icons";
    font:                "JetBrainsMono Nerd Font 11";
    terminal:            "xterm";
    drun-display-format: "{name}";
    display-drun:        "App";
    display-run:         "Esegui";
    display-window:      "Finestre";
}

* {
    bg:          #2f343f;
    bg-alt:      #272c36;
    fg:          #a1a8b9;
    fg-dim:      #7f8388;
    fg-hover:    #b4bac6;
    accent:      #b181ff;
    accent-fg:   #131c26;
    urgent:      #c67d6f;
    border:      rgba(161, 168, 185, 40%);
    selected-bg: @accent;
    selected-fg: @accent-fg;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
    spacing:          8px;
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @border;
    border-radius:    10px;
    padding:          12px;
    width:            640px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  12px;
    padding:  0px;
    border:   0px;
}

inputbar {
    children:          [ textbox-prompt-colon, entry ];
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          8px 12px;
    spacing:          8px;
}

textbox-prompt-colon {
    expand:     false;
    str:        "";
    text-color: @accent;
    margin:     0px 2px 0px 0px;
}

entry {
    placeholder:       "Cerca applicazioni...";
    placeholder-color: @fg-dim;
    text-color:        @fg;
}

textbox {
    text-color: @fg;
}

listview {
    lines:      8;
    columns:    1;
    spacing:    4px;
    scrollbar:  false;
    border:     0px;
    padding:    0px;
}

element {
    children:         [ element-icon, element-text ];
    background-color: transparent;
    border-radius:    8px;
    padding:          6px 10px;
    spacing:          12px;
    cursor:           pointer;
}

element-icon {
    size:             24px;
    background-color: transparent;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}

element.normal.normal  { background-color: transparent; text-color: @fg; }
element.normal.urgent  { background-color: transparent; text-color: @urgent; }
element.normal.active  { background-color: transparent; text-color: @fg-dim; }
element.selected.normal { background-color: @selected-bg; text-color: @selected-fg; }
element.selected.urgent { background-color: @urgent;      text-color: @accent-fg; }
element.selected.active { background-color: @selected-bg; text-color: @selected-fg; }
element.alternate.normal { background-color: transparent; text-color: @fg; }

scrollbar {
    width:        4px;
    border:       0px;
    handle-color: @accent;
    handle-width: 8px;
    padding:      0px;
}

mode-switcher {
    border:  0px;
    spacing: 4px;
}

button {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          4px 10px;
    text-color:       @fg;
}

button.selected {
    background-color: @accent;
    text-color:       @accent-fg;
}

case-indicator {
    text-color: @fg-dim;
}
